{
  "manifest_version": 3,
  "name": "Framekeep — Media Capture",
  "short_name": "Framekeep",
  "version": "1.8.0",
  "version_name": "1.8.0-beta.1",
  "minimum_chrome_version": "127",
  "description": "Capture images, video and audio into a local library. Original copies or optional PNG/JPEG cleaning; Windows companion required.",
  "key": "",
  "permissions": [
    "activeTab",
    "storage",
    "nativeMessaging",
    "contextMenus",
    "notifications",
    "sidePanel",
    "scripting",
    "webNavigation"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "side_panel": {
    "default_path": "popup.html?view=panel"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "youtube-transcript.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "capture-discovery.js",
        "frame-media.js",
        "floating.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Save with Framekeep",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; connect-src 'none'; img-src 'self' https: data:; style-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "floating.css"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
